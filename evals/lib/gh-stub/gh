#!/usr/bin/env python3
"""Fixture-driven fake `gh` for offline, deterministic skill evals.

Reads a cassette JSON file (path from GH_STUB_CASSETTE) describing canned
responses for `gh` invocations. Matches by pattern against the argv, not by
strict call order, so a skill that reaches the same outcome through a
different sequence of `gh` calls still passes -- eval graders should judge
outcomes, not the exact path taken.

Every invocation is appended to GH_STUB_LOG (if set) as one JSON object per
line, so graders can assert on what was or wasn't called (e.g. "no `pr
merge` call happened") without constraining call order.

Cassette format:

{
  "calls": [
    {
      "match": ["pr", "view"],          // ALL substrings must be found as substrings
                                         // of argv tokens, in order (each subsequent
                                         // substring must land in a strictly later token)
      "match_regex": null,               // OR a regex tested against argv joined by " "
      "times": null,                     // optional cap on how many times this entry can match (default: unlimited)
      "stdout": "...",                   // literal stdout
      "stdout_json": {...},              // OR a JSON value to serialize as stdout
      "stdout_file": "pr-view.json",     // OR a file path, relative to the cassette file's directory
      "stderr": "",
      "exit_code": 0
    }
  ],
  "default": {                           // used when no entry matches
    "exit_code": 1,
    "stderr": "gh-stub: no fixture match for this call"
  }
}

Entries are tried in file order; the first entry that matches AND still has
remaining uses (per "times") wins. An unmatched call fails loudly (using
"default", or a built-in error if "default" is absent) with the attempted
argv on stderr, so gaps in fixture coverage are obvious immediately instead
of silently returning empty data.

That last part is why falling back to "default" always writes the attempted
argv to stderr, whatever the default's own exit code and "stderr" say. A
cassette is free to set a permissive default -- exit 0 with an empty list, to
keep a trial moving past calls its author did not care to fixture -- but such
a response is indistinguishable from a real "nothing here" answer, so a skill
can skip a step it should have taken and still grade as correct. Announcing
the fallback keeps a permissive default usable without letting it lie
silently.
"""

import json
import os
import re
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path

# Tracks how many times each cassette entry (by index) has matched, within
# this single process invocation. Cross-invocation counting isn't needed
# since each `gh` call is a fresh process; "times" caps are enforced by
# writing a small counter file next to the cassette instead.
def _counter_path(cassette_path: Path) -> Path:
    counts_dir = os.environ.get("GH_STUB_COUNTS_DIR")
    if counts_dir:
        return Path(counts_dir) / (cassette_path.name + ".counts")
    return cassette_path.with_suffix(cassette_path.suffix + ".counts")


def _load_counts(cassette_path: Path) -> dict:
    counts_path = _counter_path(cassette_path)
    if counts_path.exists():
        try:
            return json.loads(counts_path.read_text())
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def _save_counts(cassette_path: Path, counts: dict) -> None:
    _counter_path(cassette_path).write_text(json.dumps(counts))


def _bounded_contains(s: str, token: str) -> bool:
    """True if `s` appears in `token` as a whole word, not embedded in a
    longer word. Prevents a substring like "merge" (intended to match the
    literal `merge` subcommand token) from also matching inside an unrelated
    word like "mergeable" or "mergeStateStatus" in a --json field-list
    value. A match counts as bounded when the character immediately before
    and after it (if any) is not alphanumeric -- so comma/slash/space/flag
    delimited occurrences (e.g. "milestone" inside
    "title,labels,milestone,assignees,body") still count, but a same-word
    prefix collision like "merge" inside "mergeable" does not.

    The boundary check on each side is only enforced when `s` itself ends
    (or begins) with an alphanumeric character. If `s` already ends with a
    delimiter -- e.g. a path-fragment match like "pulls/comments/" -- then
    whatever follows in the token (even a digit, like the numeric ID in
    ".../pulls/comments/3001") can never "extend" `s` into a different word,
    so no boundary check is needed on that side. Without this, a match
    substring deliberately ending in "/" would wrongly fail to match any
    token where it's immediately followed by more path segments or digits.
    """
    check_before = s[0].isalnum() if s else False
    check_after = s[-1].isalnum() if s else False
    start = 0
    while True:
        idx = token.find(s, start)
        if idx == -1:
            return False
        before = token[idx - 1] if idx > 0 else ""
        after = token[idx + len(s)] if idx + len(s) < len(token) else ""
        before_ok = not (check_before and before.isalnum())
        after_ok = not (check_after and after.isalnum())
        if before_ok and after_ok:
            return True
        start = idx + 1


def _matches(entry: dict, argv: list, argv_str: str) -> bool:
    substrings = entry.get("match")
    if substrings is not None:
        # Each substring must be found as a bounded (whole-word) substring of
        # some argv token, and tokens must be consumed in order (each
        # substring's token index must be strictly greater than the previous
        # substring's). This is deliberately NOT "all substrings appear
        # anywhere in the space-joined argv" -- that allowed a substring like
        # "label" (intended to match the `label` subcommand token) to also
        # match inside an unrelated later token such as a
        # `--json title,labels,milestone,...` field list, since "labels"
        # contains "label". Requiring in-order, per-token, bounded
        # containment keeps single-element path-fragment matches (e.g.
        # ["commits/abc123/check-runs"] against one `gh api <path>` token)
        # working exactly as before, while eliminating both cross-argument
        # false positives (e.g. ["label", "list"] vs. a --json field list)
        # and same-word prefix collisions (e.g. "merge" vs. "mergeable" in a
        # `gh pr view --json ...,mergeable,mergeStateStatus,...` call, which
        # previously false-triggered a `["pr", "merge"]` guard entry meant to
        # catch actual `gh pr merge` invocations).
        #
        # Multi-element entries made up ENTIRELY of bare subcommand words
        # (e.g. ["pr", "list"], ["label", "list"], no substring starting
        # with "-") represent a subcommand path, which always appears as a
        # prefix of argv before any flag. Restricting their search to that
        # prefix stops a generic entry like ["pr", "list"] from matching a
        # completely different call (e.g. `pr edit --body "...the items
        # list..."`) just because a later flag's free-text VALUE happens to
        # contain the word "list" as a bounded token. Entries that
        # themselves include a flag-like substring (e.g. ["pr", "view",
        # "--json", "assignees,isDraft"], which intentionally matches a
        # flag and its value) are exempt from this restriction -- the
        # entry author is deliberately reaching past the subcommand prefix,
        # so the full argv remains searchable. Single-element entries (e.g.
        # a `gh api <path>` fragment) are likewise exempt, since they
        # intentionally match one specific positional token.
        bare_subcommand_entry = len(substrings) > 1 and not any(
            s.startswith("-") for s in substrings
        )
        if bare_subcommand_entry:
            search_limit = len(argv)
            for i, tok in enumerate(argv):
                if tok.startswith("-"):
                    search_limit = i
                    break
        else:
            search_limit = len(argv)
        pos = 0
        for s in substrings:
            found_at = None
            for i in range(pos, search_limit):
                if _bounded_contains(s, argv[i]):
                    found_at = i
                    break
            if found_at is None:
                return False
            pos = found_at + 1
        return True
    pattern = entry.get("match_regex")
    if pattern is not None:
        return re.search(pattern, argv_str) is not None
    return False


def _resolve_stdout(entry: dict, cassette_dir: Path) -> str:
    if "stdout_file" in entry:
        return (cassette_dir / entry["stdout_file"]).read_text()
    if "stdout_json" in entry:
        return json.dumps(entry["stdout_json"])
    return entry.get("stdout", "")


def _jq_expression(argv: list) -> str:
    """The expression given to gh's -q/--jq, or "" if none was."""
    for i, tok in enumerate(argv):
        if tok in ("-q", "--jq") and i + 1 < len(argv):
            return argv[i + 1]
        if tok.startswith("--jq="):
            return tok[len("--jq="):]
    return ""


def _apply_jq(stdout: str, expression: str) -> str:
    """Filter `stdout` through jq, the way real gh does for -q/--jq.

    Ignoring the flag is not harmless. `list-pr-comments.sh` auto-detects its
    PR with `gh pr view --json number -q .number`; unfiltered, it took the
    whole response as the number and went on to build
    `pullRequest(number: PR #510)` in a GraphQL query.

    Falls back to the unfiltered text whenever the filter cannot sensibly
    apply -- output that is not JSON, a jq that errors, or no jq on the box.
    Cassettes predating this could bake the post-filter value straight into
    `stdout`, and those must keep working rather than start erroring.
    """
    if not expression or not stdout.strip():
        return stdout
    try:
        json.loads(stdout)
    except json.JSONDecodeError:
        return stdout
    try:
        result = subprocess.run(
            ["jq", "-r", expression], input=stdout,
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.SubprocessError):
        return stdout
    if result.returncode != 0:
        return stdout
    return result.stdout


def main() -> int:
    argv = sys.argv[1:]
    argv_str = " ".join(argv)

    log_path = os.environ.get("GH_STUB_LOG")
    if log_path:
        with open(log_path, "a") as f:
            f.write(json.dumps({
                "ts": datetime.now(timezone.utc).isoformat(),
                "argv": argv,
            }) + "\n")

    cassette_env = os.environ.get("GH_STUB_CASSETTE")
    if not cassette_env:
        sys.stderr.write(
            "gh-stub: GH_STUB_CASSETTE is not set; refusing to guess a response "
            f"for: gh {argv_str}\n"
        )
        return 1

    cassette_path = Path(cassette_env)
    cassette = json.loads(cassette_path.read_text())
    cassette_dir = cassette_path.parent
    counts = _load_counts(cassette_path)
    jq_expr = _jq_expression(argv)

    for idx, entry in enumerate(cassette.get("calls", [])):
        if not _matches(entry, argv, argv_str):
            continue
        times = entry.get("times")
        used = counts.get(str(idx), 0)
        if times is not None and used >= times:
            continue
        counts[str(idx)] = used + 1
        _save_counts(cassette_path, counts)
        sys.stdout.write(_apply_jq(_resolve_stdout(entry, cassette_dir), jq_expr))
        stderr = entry.get("stderr", "")
        if stderr:
            sys.stderr.write(stderr)
        return entry.get("exit_code", 0)

    default = cassette.get("default")
    if default is not None:
        sys.stdout.write(_resolve_stdout(default, cassette_dir) if (
            "stdout_file" in default or "stdout_json" in default or "stdout" in default
        ) else "")
        # Always announce the fallback, on top of whatever "stderr" the default
        # carries. A default that exits non-zero is self-evident, but a
        # permissive one (exit 0 with an empty list, say) is not: it hands back
        # a plausible "nothing here" answer that reads exactly like real data.
        # A skill can then skip a step it should have taken and still look
        # correct, and a grader has no way to tell coverage from absence. Say
        # which call went uncovered so the gap is visible in the trial itself.
        sys.stderr.write(
            f"gh-stub: no fixture entry matched: gh {argv_str}\n"
            f"gh-stub: responding from the cassette's `default`, which is a "
            f"coverage gap and not an answer about the world. If this call "
            f"belongs in the flow, add a `calls` entry for it.\n"
        )
        sys.stderr.write(default.get("stderr", ""))
        return default.get("exit_code", 1)

    sys.stderr.write(
        f"gh-stub: no fixture entry matched: gh {argv_str}\n"
        f"cassette: {cassette_path}\n"
        "Add a `calls` entry (with \"match\" or \"match_regex\") to cover this invocation.\n"
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
